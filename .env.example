AWS_REGION=us-east-1
S3_INPUT_BUCKET=lexcloud-documents-input-thang123
S3_OUTPUT_BUCKET=lexcloud-documents-output-thang123
USERS_TABLE=users
DOCUMENTS_TABLE=doc_v2
FLASK_ENV=development
FLASK_SECRET_KEY=your-secret-key-12345-change-in-production

# API Gateway endpoint that fronts the document-analysis Lambda.
# Flask POSTs {document_id, email} to <this>/analyze; Lambda does the
# S3 fetch, text extraction, and Gemini call, and Flask relays the result.
API_GATEWAY_URL=https://your-api-id.execute-api.us-east-1.amazonaws.com/prod

# NOTE: GEMINI_API_KEY is NOT read by Flask anymore -- it's configured
# directly on the Lambda function's environment variables, since Lambda
# is what actually calls Gemini. Get a free key at
# https://aistudio.google.com/app/apikey (no billing/credit card required).
