AWS_REGION=us-east-1
S3_INPUT_BUCKET=lexcloud-documents-input-thang123
S3_OUTPUT_BUCKET=lexcloud-documents-output-thang123
USERS_TABLE=users
DOCUMENTS_TABLE=doc_v2
FLASK_ENV=development
FLASK_SECRET_KEY=your-secret-key-12345-change-in-production

# Google Gemini API key for document analysis (/api/analyze-document).
# Get a free key at https://aistudio.google.com/app/apikey — no billing/credit card required.
GEMINI_API_KEY=your-gemini-api-key-here

# SendGrid API key for email notifications on upload/analysis completion.
# Get a free key (100 emails/day forever) at https://app.sendgrid.com/settings/api_keys
# — no credit card required. The from-email must be a verified sender in SendGrid.
SENDGRID_API_KEY=your-sendgrid-api-key-here
SENDGRID_FROM_EMAIL=your-verified-sender@example.com
